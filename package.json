{
  "name": "oris-orbital-risk-intelligence-system",
  "version": "1.0.0",
  "private": true,
  "description": "ORIS - Orbital Risk Intelligence System, a full-stack orbital risk analytics platform.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,blue \"npm run server:dev\" \"npm run web:dev\"",
    "web:dev": "next dev -p 3000",
    "server:dev": "node --watch server/src/index.js",
    "build": "next build",
    "start": "concurrently -k -n api,web -c cyan,blue \"npm run server:start\" \"npm run web:start\"",
    "web:start": "next start -p 3000",
    "server:start": "node server/src/index.js",
    "check": "next build"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^11.18.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "next": "^16.2.6",
    "pg": "^8.13.1",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwindcss": "^3.4.17",
    "three": "^0.171.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
